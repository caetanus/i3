#!/usr/bin/python3
# ss-session — asks to log in when switching to a super workspace of another
# user.
#
# Run it from the i3 config or autostart (as the desktop user):
#
#   exec --no-startup-id ss-session
#
# Listens to i3's super_workspace events. When the active super workspace has
# a user whose ss-agent is not running yet, runs ss-login for it; if the login
# is cancelled, switches back to the previous super workspace.
#
# Also gives the super workspace users a way into our PulseAudio: a second
# native protocol socket at /tmp/pulse-<user>.sock (see ss-run), and starts
# ss-notify-hub, which shows their notifications.
import getpass
import json
import os
import socket
import struct
import subprocess
import time

I3_MAGIC = b"i3-ipc"
SUBSCRIBE = 2
SUPER_WORKSPACE_EVENT = (1 << 31) | 8
HERE = os.path.dirname(os.path.realpath(__file__))


def i3_socket_path():
    path = os.environ.get("I3SOCK")
    if path:
        return path
    return subprocess.run(["i3", "--get-socketpath"], capture_output=True,
                          text=True, check=True).stdout.strip()


def send(sock, message_type, payload=b""):
    sock.sendall(I3_MAGIC + struct.pack("<II", len(payload), message_type) + payload)


def receive(sock):
    def read(n):
        data = b""
        while len(data) < n:
            chunk = sock.recv(n - len(data))
            if not chunk:
                raise ConnectionError("i3 closed the connection")
            data += chunk
        return data

    header = read(14)
    length, message_type = struct.unpack("<II", header[6:])
    return message_type, json.loads(read(length))


def agent_running(user):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(1)
            sock.connect("/tmp/ss-agent-%s.sock" % user)
        return True
    except OSError:
        return False


def i3_command(command):
    subprocess.run(["i3-msg", "-s", i3_socket_path(), command],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def on_focus(current):
    user = current.get("user")
    if not user or user == getpass.getuser() or agent_running(user):
        return
    # Let the user's programs talk to our X server.
    subprocess.run(["xhost", "+SI:localuser:%s" % user],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    login = subprocess.run([os.path.join(HERE, "ss-login"), user, current.get("name", user)])
    if login.returncode != 0:
        i3_command("super_workspace back_and_forth")


def listen():
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.connect(i3_socket_path())
        send(sock, SUBSCRIBE, b'["super_workspace"]')
        while True:
            message_type, event = receive(sock)
            if message_type == SUPER_WORKSPACE_EVENT and event.get("change") == "focus":
                on_focus(event.get("current") or {})


def share_pulseaudio():
    path = "/tmp/pulse-%s.sock" % getpass.getuser()
    if os.path.exists(path):
        return
    subprocess.run(["pactl", "load-module", "module-native-protocol-unix",
                    "auth-anonymous=1", "socket=%s" % path],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def start_notify_hub():
    # Exits by itself if another hub is already running.
    subprocess.Popen([os.path.join(HERE, "ss-notify-hub")], stdin=subprocess.DEVNULL,
                     start_new_session=True)


def main():
    share_pulseaudio()
    start_notify_hub()
    # Keep going across i3 restarts.
    while True:
        try:
            listen()
        except (OSError, ValueError, subprocess.CalledProcessError):
            time.sleep(1)


if __name__ == "__main__":
    main()
