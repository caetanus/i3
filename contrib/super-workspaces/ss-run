#!/usr/bin/python3
# ss-run — run a program as the user of the active super workspace.
#
#   bindsym Mod4+Return exec ss-run tilix
#   ss-run --user caetano-mph tilix
#
# Asks i3 (GET_SUPER_WORKSPACES) which user the active super workspace
# belongs to. Without a user, or when it is the desktop user, the program just
# runs. Otherwise the request goes to that user's ss-agent, which runs it in
# the user's own session (see ss-agent); if it is not running, ss-login asks
# for the user's password first.
import getpass
import json
import os
import socket
import struct
import subprocess
import sys

I3_MAGIC = b"i3-ipc"
GET_SUPER_WORKSPACES = 13
# Socket of the desktop user's PulseAudio server that the super workspace users
# can reach (module-native-protocol-unix, loaded by ss-session).
SHARED_PULSE_SOCKET = "/tmp/pulse-%s.sock" % getpass.getuser()


def i3_socket_path():
    path = os.environ.get("I3SOCK")
    if path:
        return path
    return subprocess.run(["i3", "--get-socketpath"], capture_output=True,
                          text=True, check=True).stdout.strip()


def i3_request(message_type, payload=b""):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.connect(i3_socket_path())
        sock.sendall(I3_MAGIC + struct.pack("<II", len(payload), message_type) + payload)
        header = b""
        while len(header) < 14:
            chunk = sock.recv(14 - len(header))
            if not chunk:
                raise ConnectionError("i3 closed the connection")
            header += chunk
        length, _ = struct.unpack("<II", header[6:])
        body = b""
        while len(body) < length:
            chunk = sock.recv(length - len(body))
            if not chunk:
                raise ConnectionError("i3 closed the connection")
            body += chunk
    return json.loads(body)


def super_workspace_user():
    try:
        state = i3_request(GET_SUPER_WORKSPACES)
    except Exception:
        # Not our i3 (or no i3 at all): behave like a plain exec.
        return None
    return (state.get("current") or {}).get("user")


def send_to_agent(user, request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(10)
        sock.connect("/tmp/ss-agent-%s.sock" % user)
        sock.sendall(request)
        return json.loads(sock.makefile("r").readline())


def notify(message):
    subprocess.run(["notify-send", "-a", "ss-run", "ss-run", message],
                   stderr=subprocess.DEVNULL)


def main():
    argv = sys.argv[1:]
    user = None
    if argv[:1] == ["--user"]:
        if len(argv) < 2:
            sys.exit("usage: ss-run [--user <user>] <program> [args...]")
        user, argv = argv[1], argv[2:]
    if not argv:
        sys.exit("usage: ss-run [--user <user>] <program> [args...]")

    if user is None:
        user = super_workspace_user()
    if not user or user == getpass.getuser():
        os.execvp(argv[0], argv)

    # Let the user's programs talk to our X server.
    subprocess.run(["xhost", "+SI:localuser:%s" % user],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    env = {key: os.environ[key]
           for key in ("DISPLAY", "LANG", "LC_ALL", "XDG_CURRENT_DESKTOP", "TERM", "DESKTOP_STARTUP_ID")
           if key in os.environ}
    if os.path.exists(SHARED_PULSE_SOCKET):
        env["PULSE_SERVER"] = "unix:" + SHARED_PULSE_SOCKET

    request = (json.dumps({"argv": argv, "env": env}) + "\n").encode()
    try:
        reply = send_to_agent(user, request)
    except OSError:
        # Not logged in (yet): log in, then try again.
        login = os.path.join(os.path.dirname(os.path.realpath(__file__)), "ss-login")
        if subprocess.run([login, user]).returncode != 0:
            sys.exit(1)
        try:
            reply = send_to_agent(user, request)
        except (OSError, ValueError) as e:
            notify("ss-agent of %s is not reachable (%s)" % (user, e))
            sys.exit(1)

    if not reply.get("ok"):
        notify("%s: %s" % (user, reply.get("error")))
        sys.exit(1)


if __name__ == "__main__":
    main()
